# Copiar a .env y completar. Ninguno tiene valor por defecto en producción.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Servicios de infra/docker-compose.yml
DATABASE_URL=postgresql://gambito:gambito@localhost:5433/gambito?schema=public
REDIS_URL=redis://localhost:6380

# Origen del front, para CORS y para volver del callback de OAuth
WEB_ORIGIN=http://localhost:5173

# Secretos de sesión: generar con `openssl rand -base64 48`
JWT_SECRET=cambiar-esto-por-un-secreto-largo-de-al-menos-32-caracteres
COOKIE_SECRET=cambiar-esto-tambien-por-otro-secreto-largo-distinto

# Credenciales de Google Cloud Console → APIs y servicios → Credenciales.
# Redirect URI autorizado: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Límites por IP. Estos son los de producción; para correr las pruebas de punta a
# punta en local conviene subirlos, porque crean muchas cuentas seguidas.
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_LOGIN_MAX=20
