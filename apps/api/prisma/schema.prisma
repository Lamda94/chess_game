generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  MODERATOR
  ADMIN
}

enum Category {
  BULLET
  BLITZ
  RAPID
  CLASSICAL
}

enum GameStatus {
  WAITING
  ACTIVE
  FINISHED
}

enum GameResult {
  WHITE
  BLACK
  DRAW
}

enum Termination {
  CHECKMATE
  RESIGNATION
  TIMEOUT
  STALEMATE
  AGREEMENT
  THREEFOLD
  FIFTY_MOVE
  INSUFFICIENT_MATERIAL
  ABANDONED
}

enum OAuthProvider {
  GOOGLE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum TournamentFormat {
  SWISS
  ARENA
  KNOCKOUT
}

enum TournamentStatus {
  SCHEDULED
  RUNNING
  FINISHED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  /// Único dato público de la cuenta. Nulo hasta que un alta por OAuth lo elige.
  username      String?   @unique
  /// Copia en minúsculas para reservar el nombre sin importar cómo se escriba.
  usernameLower String?   @unique
  email         String    @unique
  emailVerified Boolean   @default(false)
  /// Nulo en las cuentas que sólo entran por OAuth.
  passwordHash  String?
  avatarUrl     String?
  bio           String?
  country       String?
  role          Role      @default(PLAYER)
  /// Personalización del tablero. Van en la cuenta y no en el navegador para que
  /// acompañen a la persona de un dispositivo a otro.
  pieceSet      String    @default("clasicas")
  boardTheme    String    @default("madera")
  /// Cuenta suspendida por moderación: no puede entrar ni jugar.
  suspendedAt   DateTime?
  suspendedFor  String?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())

  ratings        Rating[]
  oauthAccounts  OAuthAccount[]
  refreshTokens  RefreshToken[]
  authTokens     AuthToken[]
  gamesAsWhite   Game[]         @relation("WhitePlayer")
  gamesAsBlack   Game[]         @relation("BlackPlayer")
  chatMessages   ChatMessage[]
  lessonProgress LessonProgress[]
  tournamentsCreated Tournament[]      @relation("TournamentCreator")
  tournamentEntries  TournamentEntry[]
  amistadesPedidas   Friendship[]      @relation("AmistadPedida")
  amistadesRecibidas Friendship[]      @relation("AmistadRecibida")
  desafiosEnviados   Challenge[]       @relation("DesafioEnviado")
  desafiosRecibidos  Challenge[]       @relation("DesafioRecibido")
  puzzleAttempts PuzzleAttempt[]
  puzzleStats    PuzzleStats?
  achievements   UserAchievement[]

  @@index([lastSeenAt])
}

model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          OAuthProvider
  providerAccountId String
  email             String
  avatarUrl         String?
  createdAt         DateTime      @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Para qué sirve un token de un solo uso enviado por correo.
enum AuthTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// Token de un solo uso que viaja por correo. Igual que el refresh, sólo se
/// guarda el hash: quien lea la tabla no puede usarlos.
model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime
  createdAt DateTime         @default(now())
  /// Sellado al consumirlo: un token vale una sola vez.
  usedAt    DateTime?

  @@index([userId, purpose])
  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Sólo se guarda el hash: un volcado de la tabla no permite robar sesiones.
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  /// Apunta al token que lo reemplazó, para detectar reuso de un token rotado.
  replacedById String?

  @@index([userId])
  @@index([expiresAt])
}

model Rating {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category
  rating      Int      @default(1500)
  rd          Float    @default(350)
  volatility  Float    @default(0.06)
  peak        Int      @default(1500)
  gamesPlayed Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([userId, category])
  @@index([category, rating])
}

model Game {
  id           String      @id @default(cuid())
  whiteId      String
  white        User        @relation("WhitePlayer", fields: [whiteId], references: [id])
  blackId      String
  black        User        @relation("BlackPlayer", fields: [blackId], references: [id])
  category     Category
  initialSec   Int
  incrementSec Int
  rated        Boolean     @default(true)
  status       GameStatus  @default(ACTIVE)
  pgn          String      @default("")
  finalFen     String?
  result       GameResult?
  termination  Termination?

  whiteRatingBefore Int?
  blackRatingBefore Int?
  whiteRatingAfter  Int?
  blackRatingAfter  Int?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  /// Cuando la partida pertenece a un torneo.
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])

  moves    Move[]
  messages ChatMessage[]
  pairing  TournamentPairing?

  @@index([whiteId, startedAt])
  @@index([blackId, startedAt])
  @@index([status])
}

model Move {
  id              String  @id @default(cuid())
  gameId          String
  game            Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// Medio-jugada, empezando en 1.
  ply             Int
  san             String
  uci             String
  fenAfter        String
  /// Reloj del jugador que movió, ya con el incremento sumado.
  clockMsAfter    Int
  evalCp          Int?

  @@unique([gameId, ply])
  @@index([gameId])
}

/// El contenido de las lecciones vive en el código (packages/chess-core), no en la
/// base: acá sólo se guarda quién completó qué. Por eso la referencia es el slug y
/// no una clave foránea.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("AmistadPedida", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("AmistadRecibida", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model Challenge {
  id           String          @id @default(cuid())
  fromId       String
  from         User            @relation("DesafioEnviado", fields: [fromId], references: [id], onDelete: Cascade)
  /// Nulo en un desafío abierto: lo toma quien abra el enlace.
  toId         String?
  to           User?           @relation("DesafioRecibido", fields: [toId], references: [id], onDelete: Cascade)
  initialSec   Int
  incrementSec Int
  rated        Boolean         @default(true)
  /// Color que pide quien desafía; nulo es al azar.
  color        String?
  status       ChallengeStatus @default(PENDING)
  gameId       String?
  createdAt    DateTime        @default(now())
  expiresAt    DateTime

  @@index([toId, status])
  @@index([status, expiresAt])
}

model Tournament {
  id           String           @id @default(cuid())
  name         String
  description  String?
  format       TournamentFormat
  category     Category
  initialSec   Int
  incrementSec Int
  /// Rondas previstas en suizo y eliminación; nulo en arena, que va por tiempo.
  rounds       Int?
  currentRound Int              @default(0)
  /// Duración en minutos de una arena.
  durationMin  Int?
  status       TournamentStatus @default(SCHEDULED)
  startsAt     DateTime
  endedAt      DateTime?
  minRating    Int?
  maxRating    Int?
  maxPlayers   Int?
  isPrivate    Boolean          @default(false)
  /// Código de acceso de un torneo privado.
  joinCode     String?          @unique
  /// Medio punto al que queda sin rival en una ronda impar.
  halfPointBye Boolean          @default(true)
  createdById  String
  createdBy    User             @relation("TournamentCreator", fields: [createdById], references: [id])
  createdAt    DateTime         @default(now())

  entries  TournamentEntry[]
  pairings TournamentPairing[]
  games    Game[]

  @@index([status, startsAt])
}

model TournamentEntry {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Puntos del torneo: en suizo 1 por victoria, en arena 2 con bonus de racha.
  score        Float      @default(0)
  games        Int        @default(0)
  streak       Int        @default(0)
  /// Rating al momento de inscribirse, que es el que ordena la siembra.
  seedRating   Int
  withdrawn    Boolean    @default(false)
  eliminated   Boolean    @default(false)
  joinedAt     DateTime   @default(now())

  @@unique([tournamentId, userId])
  @@index([tournamentId, score])
}

model TournamentPairing {
  id           String      @id @default(cuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round        Int
  board        Int
  whiteId      String?
  blackId      String?
  gameId       String?     @unique
  game         Game?       @relation(fields: [gameId], references: [id])
  result       GameResult?
  /// Una fila sin rival: el jugador pasa o suma el bye.
  isBye        Boolean     @default(false)
  byeUserId    String?

  @@unique([tournamentId, round, board])
  @@index([tournamentId, round])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonSlug  String
  completedAt DateTime @default(now())

  @@unique([userId, lessonSlug])
  @@index([userId])
}

model PuzzleAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Identificador del puzzle en el set del código.
  puzzleId    String
  solved      Boolean
  msTaken     Int
  attemptedAt DateTime @default(now())

  @@index([userId, attemptedAt])
}

model PuzzleStats {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating       Int      @default(1200)
  solved       Int      @default(0)
  failed       Int      @default(0)
  /// Aciertos seguidos ahora mismo.
  streak       Int      @default(0)
  bestStreak   Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model UserAchievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Código del logro, definido en el código.
  code       String
  unlockedAt DateTime @default(now())

  @@unique([userId, code])
  @@index([userId])
}

model ChatMessage {
  id     String   @id @default(cuid())
  gameId String
  game   Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body   String
  at     DateTime @default(now())

  @@index([gameId, at])
}
