# Copiar a infra/.env.prod y completar. Ese archivo NO se versiona.

# Dominio, ya apuntando por DNS a este servidor. Caddy saca el certificado solo.
GAMBITO_DOMAIN=gambito.tudominio.com

# Sólo si desplegás detrás de otro proxy que ya tiene el 80 y el 443
# (docker-compose.proxy.yml). Ahí GAMBITO_DOMAIN pasa a ser `:80` y el dominio
# público va acá.
# WEB_ORIGIN=https://gambito.tudominio.com
# GAMBITO_PUERTO_INTERNO=3002

# Base de datos. La contraseña sólo circula por la red interna de Docker, pero
# igual conviene que sea larga: generala con `openssl rand -base64 24`.
POSTGRES_USER=gambito
POSTGRES_PASSWORD=
POSTGRES_DB=gambito

# Secretos de sesión. Uno distinto para cada uno:
#   openssl rand -base64 48
# La app se niega a arrancar en producción si quedan los de ejemplo.
JWT_SECRET=
COOKIE_SECRET=

# Correo saliente. Es obligatorio: sin esto nadie puede verificar su cuenta ni
# recuperar la contraseña, y la API no arranca.
SMTP_URL=smtp://usuario:clave@smtp.tuproveedor.com:587
MAIL_FROM=Gambito <no-responder@tudominio.com>

# Google OAuth (opcional). Sin esto la app funciona, sólo que sin el botón de
# Google. El redirect URI autorizado tiene que ser exactamente:
#   https://TU_DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
